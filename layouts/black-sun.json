{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.15"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "black-sun-brand"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces-tree"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents-list"
              },
              "size": {
                "weight": 1
              },
              "min": 41
            },
            {
              "id": "skills",
              "type": "block",
              "content": {
                "mod": "skill-tree"
              },
              "size": {
                "px": 32
              }
            },
            {
              "id": "mcps",
              "type": "block",
              "content": {
                "mod": "mcp-tree"
              },
              "size": {
                "px": 32
              }
            },
            {
              "id": "usage",
              "type": "block",
              "content": {
                "mod": "weekly-usage"
              },
              "size": {
                "px": 124
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "top",
          "type": "row",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "black-sun-tabs"
              },
              "window_drag": true
            },
            {
              "id": "sbs-tabs",
              "type": "block",
              "content": {
                "mod": "side-by-side",
                "props": {
                  "part": "tabs"
                }
              },
              "hidden": true,
              "window_drag": true
            },
            {
              "id": "sbs-switch",
              "type": "block",
              "content": {
                "mod": "side-by-side",
                "props": {
                  "part": "switch"
                }
              },
              "size": {
                "px": 96
              },
              "window_drag": true
            }
          ],
          "size": {
            "px": 42
          },
          "resizable": false
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 2,
                    "color": "border"
                  },
                  "focus": {
                    "width": 2,
                    "color": "#8b7cf6"
                  },
                  "radius": 0,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "sbs",
              "type": "row",
              "children": [
                {
                  "id": "sbs-empty",
                  "type": "block",
                  "content": {
                    "mod": "side-by-side",
                    "props": {
                      "part": "empty"
                    }
                  }
                }
              ],
              "hidden": true,
              "gap": 8
            },
            {
              "id": "sbs-arrange",
              "type": "block",
              "content": {
                "mod": "side-by-side",
                "props": {
                  "part": "arrange"
                }
              },
              "hidden": true
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
